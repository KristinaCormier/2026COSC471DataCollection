# Environment variable template for the project.
# Copy to .env and replace placeholder values as needed.

# API configuration
FMP_API_KEY=your_api_key_here

# Database connection
# Prefer DATABASE_URL for tools that support it.
DATABASE_URL=
DB_HOST=your_db_host
DB_PORT=5432
DB_NAME=your_db_name
DB_USER=your_username
DB_PASSWORD=your_password

# Logging
# Relative paths are resolved from the project root by setup scripts.
LOG_DIR=./logs

# Data collection settings
SYMBOLS=AAPL,AMD,AMZN,BA,BABA,BAC,C,CSCO,CVX,DIS,F,GE,GOOGL,IBM,INTC,JNJ,JPM,KO,MCD,META,MSFT,NFLX,NVDA,PFE,T,TSLA,VZ,WMT,XOM
MARKET_TZ=America/New_York
WINDOW_MINUTES=5
MARKET_OPEN=04:00
MARKET_CLOSE=21:00

# Optional historical CSV loader default
CSV_PATH=

# Cron schedules
COLLECTION_SCHEDULE="0 * * * *"
STG_TO_CORE_SCHEDULE="0 2 * * *"
BACKUP_CRON_SCHEDULE="0 2 * * *"

# Cron installer behavior for setup_cronjob_*.sh
# user: project-local wrapper + user crontab (default)
# system: /usr/local/bin wrapper + /etc/cron.d entry (requires sudo)
CRON_INSTALL_MODE=user
CRON_WRAPPER_DIR=.ops/bin

# Test configuration
TEST_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/test_database

# Server and replication setup (for setup_scripts/server_setup/*)
LIST_OF_SUDO_USERS=("etl" "admin")
PRIMARY_USER=postgres
PRIMARY_IP=10.0.0.10
PG_CONF=/var/lib/pgsql/16/data/postgresql.conf
PG_HBA=/var/lib/pgsql/16/data/pg_hba.conf
REPLICATION_USER=replicator
REPLICATION_PASSWORD=change_me
SLOT_NAME=replica_slot_1
DATA_DIR=/var/lib/pgsql/16/data

# Backup configuration (for setup_scripts/database_setup/*)
BACKUP_DIR=/var/lib/pgsql/16/backups
USER_FOR_DB_BACKUPS=postgres
PASSWORD_FOR_DB_BACKUPS=change_me
